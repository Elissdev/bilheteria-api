{
  "name": "bilheteria-api",
  "version": "2.0.0",
  "description": "API REST de bilheteria em Node.js/Express com PostgreSQL, documentação Swagger, testes automatizados e 100% de cobertura.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "api",
    "nodejs",
    "express",
    "postgres",
    "qa",
    "jest",
    "swagger"
  ],
  "author": "Elissandra Silva",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "knex": "^3.2.9",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "app.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
